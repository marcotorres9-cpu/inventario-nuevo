{
  "appId": "com.inventariopro.app",
  "appName": "Inventario",
  "webDir": "public",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "inventario-nuevo-v2.vercel.app",
      "*.vercel.app"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true,
      "backgroundColor": "#09090b"
    }
  }
}
